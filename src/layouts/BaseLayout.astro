---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { avatarUrl, site, socials } from '../config';
import PreferenceControls from '../components/PreferenceControls.astro';
import { localeMeta, localizePath, t, type Locale } from '../i18n/ui';
import { getPage } from '../lib/pages';

interface Props { title?: string; description?: string; locale?: Locale; hasTranslation?: boolean; alternateHref?: string | null; }
const locale = Astro.props.locale ?? (Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/') ? 'en' : 'zh');
const [homePage, archivePage, projectsPage, aboutPage] = await Promise.all([
  getPage('home', locale),
  getPage('posts', locale),
  getPage('projects', locale),
  getPage('about', locale),
]);
const { title, description, hasTranslation = true, alternateHref } = Astro.props;
const localizedSiteName = site.siteName[locale];
const pageTitle = title ? `${title} | ${localizedSiteName}` : localizedSiteName;
const path = Astro.url.pathname;
const prefix = localeMeta[locale].prefix;
const alternateLocale: Locale = locale === 'zh' ? 'en' : 'zh';
const translationHref = hasTranslation ? (alternateHref ?? localizePath(path, alternateLocale)) : null;
const nav = [
  { href: `${prefix}/`, label: homePage.data.title },
  { href: `${prefix}/archive/`, label: archivePage.data.title },
  { href: `${prefix}/projects/`, label: projectsPage.data.title },
  { href: `${prefix}/about/`, label: aboutPage.data.title },
];
const isActive = (href: string) => href === '/' || href === '/en/' ? path === href : path.startsWith(href);
const canonicalUrl = new URL(path, site.url);
const alternateUrl = translationHref ? new URL(translationHref, site.url) : null;
const currentYear = new Date().getFullYear();
const siteYearLabel = currentYear > site.footer.startYear ? `${site.footer.startYear}-${currentYear}` : `${site.footer.startYear}`;
---
<!doctype html>
<html lang={localeMeta[locale].htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <meta name="theme-color" content="#003153" />
    <link rel="icon" href="/images/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    {alternateUrl && <><link rel="alternate" hreflang={localeMeta[locale].htmlLang} href={canonicalUrl} /><link rel="alternate" hreflang={localeMeta[alternateLocale].htmlLang} href={alternateUrl} /><link rel="alternate" hreflang="x-default" href={locale === 'zh' ? canonicalUrl : alternateUrl} /></>}
    <link rel="alternate" type="application/rss+xml" title={localizedSiteName} href={`${prefix}/rss.xml`} />
    <title>{pageTitle}</title>
    <ClientRouter />
    <script is:inline>
      (() => {
        const preference = localStorage.getItem('theme') || 'system';
        const resolved = preference === 'system'
          ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          : preference;
        document.documentElement.dataset.themePreference = preference;
        document.documentElement.dataset.theme = resolved;
        document.documentElement.dataset.locale = document.documentElement.lang === 'en' ? 'en' : 'zh';
      })();
    </script>
  </head>
  <body transition:animate="none">
    <header class="mobile-bar" transition:name="mobile-bar">
      <a class="brand" href={`${prefix}/`}>k4if3ng<small>{t(locale, 'brand.subtitle')}</small></a>
      <nav aria-label={t(locale, 'a11y.mobileNav')}>
        {nav.map(item => <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>)}
      </nav>
      <PreferenceControls locale={locale} translationHref={translationHref} />
    </header>
    <section class="shell mobile-profile" aria-label={site.name[locale]} transition:name="mobile-profile">
      <a class="mobile-identity" href={`${prefix}/`}>
        <img class="mobile-avatar" src={avatarUrl} width="56" height="56" alt={t(locale, 'a11y.avatar', { name: site.name[locale] })} />
        <span class="mobile-identity-text">
          <strong>{site.name.zh}</strong>
          <small>{site.name.en}</small>
        </span>
      </a>
      <p class="mobile-motto">{site.motto[locale]}</p>
    </section>
    <div class="shell app">
      <aside class="sidebar" transition:name="site-sidebar">
        <a class="identity" href={`${prefix}/`}>
          <img class="avatar" src={avatarUrl} width="84" height="84" alt={t(locale, 'a11y.avatar', { name: site.name[locale] })} />
          <span class="identity-name"><strong>{site.name.zh}</strong><small>{site.name.en}</small></span>
        </a>
        <div class="site-kind">{site.motto[locale]}</div>
        <nav class="nav" aria-label={t(locale, 'a11y.mainNav')}>
          {nav.map(item => <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>)}
        </nav>
        <div class="sidebar-bottom">
          <div class="socials" aria-label={t(locale, 'a11y.social')}>
            {socials.filter(item => item.href).map(item =>
              <a href={item.href} target={item.target} rel={item.target ? 'noreferrer' : undefined} aria-label={item.label} data-link-plain><i class={`social-icon social-icon-fa fa-fw ${item.icon}`} aria-hidden="true"></i></a>
            )}
          </div>
          <PreferenceControls locale={locale} translationHref={translationHref} />
        </div>
      </aside>
      <div class="layout-divider" aria-hidden="true" transition:name="site-divider"></div>
      <main class="main" transition:name="site-main">
        <slot />
        <section class="mobile-social-card" aria-label={t(locale, 'a11y.social')}>
          <div class="mobile-social-copy"><div class="kicker">{t(locale, 'social.mobileKicker')}</div><strong>{t(locale, 'social.mobileTitle')}</strong></div>
          <div class="socials mobile-socials">
            {socials.filter(item => item.href).map(item =>
              <a href={item.href} target={item.target} rel={item.target ? 'noreferrer' : undefined} aria-label={item.label} data-link-plain><i class={`social-icon social-icon-fa fa-fw ${item.icon}`} aria-hidden="true"></i></a>
            )}
          </div>
        </section>
        <footer class="footer">
          <span class="footer-copy">{siteYearLabel} {site.name[locale]}</span>
          <span class="footer-separator" aria-hidden="true">·</span>
          <span class="footer-built">{t(locale, 'footer.builtBefore')}{' '}<a class="footer-link" href={site.footer.builtWith.href} target={site.footer.builtWith.target} rel={site.footer.builtWith.target ? 'noreferrer' : undefined} data-link-plain>{site.footer.builtWith.label}</a>{t(locale, 'footer.builtAfter') && <> {' '}{t(locale, 'footer.builtAfter')}</>}</span>
        </footer>
      </main>
    </div>
    <script src="../scripts/site-behavior.ts"></script>
  </body>
</html>

---
import PostPage from '../../components/pages/PostPage.astro';
import { getPostStaticPaths } from '../../lib/posts';
export async function getStaticPaths() { return getPostStaticPaths('zh'); }
const { post, redirectTo, older, newer } = Astro.props;
if (redirectTo) return Astro.redirect(redirectTo, 301);
---
<PostPage post={post} older={older} newer={newer} />

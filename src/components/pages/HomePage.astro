---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../PostList.astro';
import { getPosts } from '../../lib/posts';
import { getProjects } from '../../lib/projects';
import { localeMeta, t, type Locale } from '../../i18n/ui';
import { site } from '../../config';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const posts = await getPosts(locale);
const projects = await getProjects(locale);
const prefix = localeMeta[locale].prefix;
---
<BaseLayout locale={locale}>
  <section class="hero">
    <div class="hero-kicker">
      <span>{t(locale, 'home.kicker')}</span>
      <span class="hero-kicker-line" aria-hidden="true"></span>
    </div>
    <h1>{site.locales[locale].title}</h1>
    <p class="hero-lead">{t(locale, 'home.title')}</p>
    <p class="hero-description">{site.locales[locale].homeIntro}</p>
  </section>
  <section class="section">
    <div class="section-head"><div><div class="eyebrow">{t(locale, 'home.recentEyebrow')}</div><h2>{t(locale, 'home.recentTitle')}</h2></div><a class="text-link view-all-link link-internal" href={`${prefix}/archive/`} data-link-plain>{t(locale, 'home.viewAll')}</a></div>
    {posts.length ? <PostList posts={posts.slice(0, 5)} locale={locale} /> : <p class="empty-state">{t(locale, 'home.emptyPosts')}</p>}
  </section>
  <section class="section home-projects">
    <div class="section-head"><div><div class="eyebrow">{t(locale, 'home.projectsEyebrow')}</div><h2>{t(locale, 'home.projectsTitle')}</h2></div><a class="text-link view-all-link link-internal" href={`${prefix}/projects/`} data-link-plain>{t(locale, 'home.viewAll')}</a></div>
    {projects.slice(0, 2).map((project, index) => <a class="project-row" href={project.data.href} target="_blank" rel="noreferrer" data-link-card><span class="project-index">{String(index + 1).padStart(2, '0')}</span><span><strong>{project.data.name}</strong><small>{project.data.description}</small></span><span class="entry-arrow entry-arrow-external" aria-hidden="true"></span></a>)}
  </section>
</BaseLayout>

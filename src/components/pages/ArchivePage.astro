---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPostExcerpt, getPostPath, getPosts } from '../../lib/posts';
import { t, type Locale } from '../../i18n/ui';
import { formatDate } from '../../i18n/formatters';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const posts = await getPosts(locale);
const grouped = posts.reduce<Record<string, typeof posts>>((result, post) => {
  const year = String(post.data.publishedAt.getFullYear());
  (result[year] ??= []).push(post);
  return result;
}, {});
const years = Object.entries(grouped).sort(([a], [b]) => Number(b) - Number(a));
---
<BaseLayout locale={locale} title={t(locale, 'archive.title')}>
  <header class="page-header compact-header"><div><div class="eyebrow">{t(locale, 'archive.eyebrow')}</div><h1 class="page-title">{t(locale, 'archive.title')}</h1></div><p>{t(locale, 'archive.count', { count: posts.length })}</p></header>
  <div class="note-search"><span aria-hidden="true">⌕</span><input type="search" placeholder={t(locale, 'archive.searchPlaceholder')} aria-label={t(locale, 'archive.searchAria')} data-note-search disabled={!posts.length} /><kbd>/</kbd></div>
  <p class="search-empty" data-search-empty hidden>{t(locale, 'archive.noMatch')}</p>
  {posts.length ? <div class="archive-list">
    {years.map(([year, yearPosts]) => <section class="archive-year"><h2>{year}</h2><div>
      {yearPosts.map(post => <a class="archive-entry" href={getPostPath(post)} data-link-card data-search-entry data-search-text={`${post.data.title} ${getPostExcerpt(post)} ${post.data.tags.join(' ')}`.toLocaleLowerCase()}>
        <time class="archive-date" datetime={post.data.publishedAt.toISOString()} aria-label={post.data.publishedAt.toISOString().slice(0, 10)}><span>{formatDate(post.data.publishedAt, locale, { month: '2-digit', day: '2-digit' })}</span></time>
        <strong>{post.data.title}</strong><div class="tags">{post.data.tags.map(tag => <span class="tag">#{tag}</span>)}</div><span class="entry-arrow entry-arrow-internal" aria-hidden="true"></span>
      </a>)}
    </div></section>)}
  </div> : <p class="empty-state section">{t(locale, 'archive.empty')}</p>}
  <script is:inline>
    const searchInput = document.querySelector('[data-note-search]');
    const entries = [...document.querySelectorAll('[data-search-entry]')];
    const empty = document.querySelector('[data-search-empty]');
    const applySearch = () => {
      const query = searchInput?.value.trim().toLocaleLowerCase() || '';
      let visible = 0;
      entries.forEach((entry) => {
        const match = !query || entry.dataset.searchText.includes(query);
        entry.hidden = !match;
        if (match) visible += 1;
      });
      document.querySelectorAll('.archive-year').forEach((section) => { section.hidden = !section.querySelector('[data-search-entry]:not([hidden])'); });
      if (empty) empty.hidden = visible !== 0;
    };
    searchInput?.addEventListener('input', applySearch);
    document.addEventListener('keydown', (event) => {
      if (event.key === '/' && !['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName)) { event.preventDefault(); searchInput?.focus(); }
      if (event.key === 'Escape' && document.activeElement === searchInput) { searchInput.value = ''; applySearch(); searchInput.blur(); }
    });
  </script>
</BaseLayout>

---
import { t, type Locale } from '../i18n/ui';
import { themeOptions } from '../config/theme';

interface Props { locale: Locale; translationHref?: string | null; }
const { locale, translationHref } = Astro.props;
const themeIconClasses = {
  system: 'fa-circle-half-stroke',
  light: 'fa-sun',
  dark: 'fa-moon',
} as const;
---
<div class="quick-controls preference-controls">
  {translationHref
    ? <a class="quick-control language-switch" href={translationHref} data-link-plain data-tooltip={t(locale, 'language.switch')} aria-label={t(locale, 'language.switch')}>
        <i class="preference-icon fa-solid fa-language" aria-hidden="true"></i>
      </a>
    : <span class="quick-control language-switch is-disabled" data-tooltip={t(locale, 'language.current')} aria-label={t(locale, 'language.current')}>
        <i class="preference-icon fa-solid fa-language" aria-hidden="true"></i>
      </span>}
  <details class="control-menu theme-menu">
    <summary class="quick-control theme-toggle" data-tooltip={t(locale, 'theme.change')} aria-label={t(locale, 'theme.change')}>
      <i class={`preference-icon fa-solid ${themeIconClasses.system}`} data-theme-current-icon aria-hidden="true"></i>
    </summary>
    <div class="control-popover theme-popover" role="menu">
      {themeOptions.map(option => <button class="theme-option" type="button" data-theme-option={option.value} role="menuitemradio" aria-checked="false">
        <i class={`preference-icon theme-option-icon fa-solid ${themeIconClasses[option.value]}`} aria-hidden="true"></i><span>{t(locale, option.labelKey)}</span><span class="menu-check" data-theme-check aria-hidden="true" hidden>✓</span>
      </button>)}
    </div>
  </details>
</div>
